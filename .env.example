# Copy to .env.local

# Optional Alchemy Starknet RPC key only (not the full URL). Server-side — never NEXT_PUBLIC_.
# If empty, the app uses Cartridge public RPC.
PROVIDER_URL=

# Public origin used for social card images on claim links. Defaults to the live demo.
NEXT_PUBLIC_SITE_URL=

# Redpacket helper — public contract addresses. Override only if you redeploy.
# NEXT_PUBLIC_REDPOCKET_* is still accepted as a fallback.
NEXT_PUBLIC_REDPACKET_MAINNET=0x0671dfa406d914e9b422792b698b6cb8f585bc5f6ef789f31d65b46143fdaef5
NEXT_PUBLIC_REDPACKET_SEPOLIA=0x04ec2a146f05c73ffc4ab6cbf482ef60847499515d8c44be622a6007ffd0c588
